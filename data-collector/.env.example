# PostgreSQL. DATABASE_URL takes precedence when set (Railway supplies it).
POSTGRES_USER=prediction_collector
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=prediction_markets
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=

# Docker Compose only.
POSTGRES_BIND_HOST=127.0.0.1
COLLECTOR_IMAGE=prediction-market-collector:local
MINIO_ROOT_USER=local-archive-admin
MINIO_ROOT_PASSWORD=change-this-local-archive-password
MINIO_BIND_HOST=127.0.0.1

# Required archive storage. These defaults target the Compose MinIO service.
# Native Windows execution should use http://127.0.0.1:9000 instead.
S3_ENDPOINT_URL=http://object-store:9000
S3_BUCKET=prediction-market-archive
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-archive-admin
S3_SECRET_ACCESS_KEY=change-this-local-archive-password
S3_PREFIX=production
S3_URL_STYLE=path

# Polymarket auxiliary feeds. Continuous market discovery is always enabled.
POLYMARKET_RTDS_ENABLED=true
POLYMARKET_SPORTS_ENABLED=true
POLYMARKET_COMMENTS_ENABLED=false

# Dynamic collection tiers. Discovery and metadata remain comprehensive.
FULL_L2_MAX_MARKETS=10
SAMPLED_MAX_MARKETS=50
FULL_L2_MIN_SCORE=55
FULL_L2_MIN_LIQUIDITY=1000
FULL_L2_MIN_RECENT_TRADES=2
FULL_L2_MIN_BOOK_UPDATES=100
SAMPLED_PROMOTION_SCORE=20
SAMPLED_DEMOTION_SCORE=12
FULL_L2_DEMOTION_SCORE=45
TIER_MIN_DWELL_SECONDS=1800
FULL_L2_RESEARCH_RESERVE=5
FULL_L2_MARKET_ALLOWLIST=
LIVE_MARKET_BLOCKLIST=
TIER_REEVALUATION_INTERVAL_SECONDS=300
TIER_ACTIVITY_WINDOW_SECONDS=900
FULL_L2_OBSERVATION_INTERVAL_SECONDS=300
SAMPLED_SNAPSHOT_INTERVAL_SECONDS=30
SAMPLED_HEARTBEAT_INTERVAL_SECONDS=900

# Scheduling and bounded queues.
METADATA_SYNC_INTERVAL_SECONDS=900
ECONOMICS_SYNC_INTERVAL_SECONDS=3600
POLYMARKET_FEE_RATE_SYNC_INTERVAL_SECONDS=21600
ORDERBOOK_RECONCILE_INTERVAL_SECONDS=3600
METRICS_LOG_INTERVAL_SECONDS=60
STORAGE_METRICS_INTERVAL_SECONDS=300
RETENTION_INTERVAL_SECONDS=3600
HTTP_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=6
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_BATCH_SIZE=500
DATABASE_FLUSH_INTERVAL_SECONDS=2
DATABASE_QUEUE_SIZE=50000
POLYMARKET_WS_SUBSCRIPTION_CHUNK_SIZE=500

# Parquet/Zstd archive writer. Bytes are decimal integers.
ARCHIVE_BATCH_ROWS=250000
ARCHIVE_BATCH_BYTES=50331648
ARCHIVE_FLUSH_SECONDS=300
ARCHIVE_COMPRESSION=zstd
ARCHIVE_ZSTD_LEVEL=3
ARCHIVE_ROW_GROUP_ROWS=100000
ARCHIVE_QUEUE_MAX_ROWS=50000
ARCHIVE_QUEUE_MAX_BYTES=67108864
ARCHIVE_QUEUE_WARN_ROWS=35000
ARCHIVE_QUEUE_WARN_BYTES=50331648
ARCHIVE_QUEUE_CRITICAL_ROWS=47500
ARCHIVE_QUEUE_CRITICAL_BYTES=62914560
ARCHIVE_ENQUEUE_TIMEOUT_SECONDS=5
ARCHIVE_SPOOL_DIRECTORY=/tmp/prediction-collector-archive
ARCHIVE_SPOOL_MAX_BYTES=2147483648
ARCHIVE_UPLOAD_MAX_ATTEMPTS=6
ARCHIVE_COMPACTION_ENABLED=true
ARCHIVE_COMPACTION_INTERVAL_SECONDS=3600
ARCHIVE_COMPACTION_MIN_AGE_SECONDS=900
ARCHIVE_COMPACTION_MIN_OBJECTS=4
ARCHIVE_COMPACTION_TARGET_BYTES=67108864

# All malformed/unknown/parser-error frames plus a deterministic 0.1% sample
# of known-valid frames. FULL_L2 normalized deltas remain the replay source.
RAW_WS_POLICY=errors_sample
RAW_WS_VALID_SAMPLE_RATE=0.001
REFERENCE_UNCHANGED_HEARTBEAT_SECONDS=300

# PostgreSQL hot-window retention and storage pressure.
POSTGRES_REFERENCE_RETENTION_HOURS=6
POSTGRES_OBSERVATION_RETENTION_HOURS=24
CLOSED_MARKET_HOT_STATE_GRACE_HOURS=24
POSTGRES_STORAGE_WARN_GB=70
POSTGRES_STORAGE_CRITICAL_GB=85

POLYMARKET_EQUITY_SYMBOLS=AAPL,TSLA,MSFT,GOOGL,AMZN,META,NVDA,NFLX,PLTR,OPEN,RKLB,ABNB,COIN,HOOD,QQQ,SPY,EWY,VXX,EURUSD,GBPUSD,USDCAD,USDJPY,USDKRW,XAUUSD,XAGUSD,WTI,CC,NGD
LOG_LEVEL=INFO
JSON_LOGS=true

# Official public endpoints. Override only for a documented migration or test.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_SPORTS_WS_URL=wss://sports-api.polymarket.com/ws
