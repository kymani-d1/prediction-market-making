# PostgreSQL. DATABASE_URL takes precedence when it is non-empty.
POSTGRES_USER=prediction_collector
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=prediction_markets
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=

# Docker Compose only. Keep the database port bound to loopback unless remote
# access is explicitly required.
POSTGRES_BIND_HOST=127.0.0.1
COLLECTOR_IMAGE=prediction-market-collector:local
# Docker Compose authenticated profile on Linux: set these to `id -u` and
# `id -g` so the process can read a mode-0600 host key bind mount.
COLLECTOR_UID=1000
COLLECTOR_GID=1000

# Exchanges and optional authenticated Kalshi WebSocket access.
POLYMARKET_ENABLED=true
KALSHI_ENABLED=true
KALSHI_API_KEY_ID=
# Native execution: absolute path to a rotated RSA private-key PEM file.
KALSHI_PRIVATE_KEY_PATH=
# Docker Compose authenticated profile: host path to that same PEM file.
# Never paste private-key contents into this file.
KALSHI_PRIVATE_KEY_HOST_PATH=

# Raw-source retention and exchange-provided auxiliary feeds.
STORE_RAW_WS=true
STORE_RAW_REST=true
POLYMARKET_RTDS_ENABLED=true
POLYMARKET_SPORTS_ENABLED=true
POLYMARKET_COMMENTS_ENABLED=true
KALSHI_REFERENCE_FEEDS_ENABLED=true

# Live-market coverage. Zero means unrestricted. These settings affect only
# continuous live market subscriptions; metadata and historical backfills are
# always uncapped.
MAX_LIVE_MARKETS=0
MIN_LIVE_MARKET_VOLUME=0
MIN_LIVE_MARKET_LIQUIDITY=0
# Comma-separated selectors. A selector may be an exchange external market ID,
# ticker, slug, condition ID, or outcome token ID exposed by discovery.
LIVE_MARKET_ALLOWLIST=
LIVE_MARKET_BLOCKLIST=

# Scheduling and throughput.
METADATA_SYNC_INTERVAL_SECONDS=300
# Refresh current fee/reward/incentive configurations hourly during live collection.
# This general live refresh omits per-token Polymarket fee requests; the slower
# dedicated cadence below and explicit backfills collect them comprehensively.
ECONOMICS_SYNC_INTERVAL_SECONDS=3600
# Per-token Polymarket fee rates require one authoritative CLOB request per
# outcome token, so refresh them on an independent six-hour cadence.
POLYMARKET_FEE_RATE_SYNC_INTERVAL_SECONDS=21600
MARKET_SNAPSHOT_INTERVAL_SECONDS=60
ORDERBOOK_RECONCILE_INTERVAL_SECONDS=300
METRICS_LOG_INTERVAL_SECONDS=60
HTTP_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=6
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_BATCH_SIZE=500
DATABASE_FLUSH_INTERVAL_SECONDS=2
DATABASE_QUEUE_SIZE=50000

# These split large subscription sets across WebSocket connections. They are
# not market-coverage limits and do not exclude any eligible market.
POLYMARKET_WS_SUBSCRIPTION_CHUNK_SIZE=500
KALSHI_WS_SUBSCRIPTION_CHUNK_SIZE=100

# Polymarket Pyth/equity RTDS symbols. Leaving the variable absent uses the
# source-code default; this explicit value matches that default.
POLYMARKET_EQUITY_SYMBOLS=AAPL,TSLA,MSFT,GOOGL,AMZN,META,NVDA,NFLX,PLTR,OPEN,RKLB,ABNB,COIN,HOOD,QQQ,SPY,EWY,VXX,EURUSD,GBPUSD,USDCAD,USDJPY,USDKRW,XAUUSD,XAGUSD,WTI,CC,NGD

LOG_LEVEL=INFO
JSON_LOGS=true

# Upstream endpoints. Override only for a proxy, test fixture, or an announced
# exchange migration.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_SPORTS_WS_URL=wss://sports-api.polymarket.com/ws
KALSHI_API_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
